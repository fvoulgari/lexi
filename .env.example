# Copy to .env; placeholders only. Never commit .env or production values.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://notebook:YOUR_URL_SAFE_PASSWORD@localhost:5432/notebook
PUBLIC_ORIGIN=http://localhost:5173
# Local HTTP only; production must use true and an HTTPS PUBLIC_ORIGIN.
COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1
# Managed SuperTokens Core: HTTPS URI and backend-only API key.
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit SMTP sender; production requires implicit TLS (normally port 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
# Claim links expire after this many hours; allowed 1–168.
CLAIM_HOURS=48
LOGIN_LIMIT=5
