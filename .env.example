# Copy to .env; generate your own values. Never commit .env.
# Use a URL-safe database password in local Compose.
POSTGRES_PASSWORD=
# At least 12 and at most 256 characters.
SHARED_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# For running the backend directly, use a PostgreSQL connection URL.
DATABASE_URL=postgresql+psycopg://notebook:YOUR_URL_SAFE_PASSWORD@localhost:5432/notebook
PUBLIC_ORIGIN=http://localhost:5173
# Local HTTP only. Production/Railway must use true (the application default).
COOKIE_SECURE=false
# Production only: set this to trusted reverse-proxy addresses.
FORWARDED_ALLOW_IPS=127.0.0.1
