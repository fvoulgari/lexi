# PREPARATION ONLY: placeholders must not be deployed.
# Enter real values directly in Railway's staging app Variables; never commit them.
# New private staging PostgreSQL only; never reference production variables.
DATABASE_URL=REPLACE_WITH_PRIVATE_STAGING_DATABASE_URL
PUBLIC_ORIGIN=https://staging.lexi.fotiniv.com
COOKIE_SECURE=true
SUPERTOKENS_CONNECTION_URI=REPLACE_WITH_DEVELOPMENT_CORE_HTTPS_URI
SUPERTOKENS_API_KEY=REPLACE_IN_PROTECTED_RAILWAY_VARIABLE
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_IN_PROTECTED_RAILWAY_VARIABLE
# Resend HTTPS API; verified sender and free-plan/billing confirmation required.
RESEND_API_KEY=REPLACE_IN_PROTECTED_RAILWAY_VARIABLE
EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
FORWARDED_ALLOW_IPS=REPLACE_WITH_VERIFIED_PROXY_IPS_OR_CIDRS
CLAIM_HOURS=48
LOGIN_LIMIT=5
